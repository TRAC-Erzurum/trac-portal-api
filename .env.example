# ============================================
# TRAC Portal API - Environment Configuration
# ============================================

# --------------------------------------------
# Application Settings
# --------------------------------------------
NODE_ENV=development
PORT=8000
DOMAIN=0.0.0.0

# Application versions (optional, for health checks)
APP_VERSION=1.0.0
UI_VERSION=1.0.0

# --------------------------------------------
# Database Configuration (PostgreSQL)
# --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_NAME=trac_portal
DB_SSL=false

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h

# --------------------------------------------
# OpenID Connect provider ("sign in with TRAC Portal")
# --------------------------------------------
# Public origin the browser and client apps reach this API (and the UI) on,
# no trailing slash. Issuer becomes ${PUBLIC_API_ORIGIN}/api/oidc.
# The UI must be served from the same origin (consent page: /oidc/consent).
# Local dev through the Vite proxy: http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:5173

# --------------------------------------------
# Google OAuth (Optional - for Google login)
# --------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
# Frontend base URL (for redirects after Google login; no trailing slash)
FRONTEND_URL=http://localhost:5173

# --------------------------------------------
# Cloudflare Turnstile CAPTCHA (Optional)
# --------------------------------------------
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# --------------------------------------------
# Cloudflare R2 Storage (Optional - for uploads)
# Key prefix is auto: trac-portal-${NODE_ENV}
# --------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# --------------------------------------------
# Feedback → GitHub Issues (optional in dev)
# --------------------------------------------
# Feedback is saved in the database first. Forwarding to GitHub starts once the
# three GITHUB_APP_* values are set; until then records stay pending.
# GitHub App ID (numeric) and installation ID on the repository (numeric)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# App private key (PEM). Literal \n escapes are accepted.
GITHUB_APP_PRIVATE_KEY=
# Repo URL: https://github.com/OWNER/REPO (http, www, .git, /tree/… suffixes are OK)
GITHUB_REPO_WEB_URL=
